CLOUDY_MASTER_SECRET=your_master_secret
TURSO_AUTH_TOKEN=your_turso_auth_token
TURSO_REMOTE_URL=your_turso_remote_url

# platform api credentials, used to create one turso database per tenant
# mint with: turso auth api-tokens mint cloudy
TURSO_API_TOKEN=your_turso_platform_api_token
TURSO_ORG=your_turso_org_slug
TURSO_GROUP=default
TURSO_DB_PREFIX=cloudy-
CLOUDY_DOMAIN=your_domain
CLOUDY_PORT=8080

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Cloudy
